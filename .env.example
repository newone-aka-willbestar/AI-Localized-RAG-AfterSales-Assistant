# ==========================================
# 复制本文件为 .env，填入你自己的值
# cp .env.example .env
# ==========================================

# LLM 提供商选择: ollama（本地）或 deepseek（API）
LLM_PROVIDER=ollama

# --- Ollama 本地配置 ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:7b

# --- DeepSeek API 配置（使用 deepseek 时必填）---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# --- 翻译配置 ---
# 可选: ollama / deepseek / none
TRANSLATION_PROVIDER=deepseek

# --- Qdrant 向量数据库（本地 Docker 默认值无需修改）---
# 本地开发：docker compose up -d 启动后保持默认
# 云端部署：填入 Qdrant Cloud 的地址
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# --- 系统安全配置 ---
API_KEY=your-secret-key-change-this

# --- RAG 参数（可选，有默认值）---
# CHUNK_SIZE=800
# RETRIEVAL_TOP_K=10
# RERANK_TOP_K=4
